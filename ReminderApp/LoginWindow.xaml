<Window x:Class="ReminderApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="400" Width="400"
        MinWidth="350" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ForceCursor="True">

    <Window.Resources>
        <!-- Button with CornerRadius -->
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Login and Register Button Styles -->
        <Style x:Key="LoginButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
        <Style x:Key="RegisterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- TextBox and PasswordBox Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="1"/>
            <GradientStop Color="#FF4C4E56"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Login to Reminder App"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Grid.Row="0"
                   Foreground="#FFB9B9B9"/>

        <!-- Email -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Email" Style="{StaticResource SectionLabelStyle}" Foreground="#FFDCD5D5"/>
            <TextBox x:Name="EmailTextBox"
                     ToolTip="Enter your email address (e.g., user@gmail.com)"
                     SelectionBrush="#FFEFF0F1"
                     SelectionTextBrush="White"
                     Foreground="#FFF1ECEC"
                     Background="#FF3D3F45"
                     Opacity="0.5"
                     BorderBrush="#FFF5F2F2"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Password" Style="{StaticResource SectionLabelStyle}" Foreground="#FFE2D3D3"/>
            <PasswordBox x:Name="PasswordBox"
                         Background="#FF3D3F45"
                         SelectionBrush="White"
                         Foreground="#FFE8DEDE"
                         Opacity="0.5"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock x:Name="ErrorMessage"
                   Foreground="Red"
                   Visibility="Collapsed"
                   Grid.Row="3"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,10"
                   TextAlignment="Center"
                   MaxWidth="300"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0">
            <Button Content="Login"
                    Style="{StaticResource LoginButtonStyle}"
                    Click="LoginButton_Click"/>
            <Button Content="Register"
                    Style="{StaticResource RegisterButtonStyle}"
                    Click="RegisterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
