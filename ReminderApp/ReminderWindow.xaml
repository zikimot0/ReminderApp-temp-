<Window
    Height="629"
    ResizeMode="NoResize"
    Title="Set Reminder"
    Width="420"
    WindowStartupLocation="CenterScreen"
    x:Class="ReminderApp.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="#FF6B6B6B" Offset="0.481"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="20,20,20,11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <TextBlock
            FontSize="28"
            FontWeight="Bold"
            Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"
            Text="Set a Reminder" >
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF6D6969"/>
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>

        <!--  Date Selection  -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#FFF3E8E8"
                Margin="0,0,0,5"
                Text="Select Date" />
            <DatePicker
                Background="#FF3C3C3C"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Margin="0,0,0,10"
                Padding="5"
                x:Name="ReminderCalendar" />
        </StackPanel>

        <!--  Time Input  -->
        <!--  Time Input  -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock
        FontSize="14"
        FontWeight="SemiBold"
        Foreground="#FFEDE9E9"
        Margin="0,0,0,5"
        Text="Select Time" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="HourComboBox"
                  Width="60"
                  Margin="0,0,10,0"
                  Background="#FF3C3C3C"
                  VerticalContentAlignment="Center">
                    <!-- Populate hours 00 - 23 -->
                    <ComboBoxItem Content="00" />
                    <ComboBoxItem Content="01" />
                    <ComboBoxItem Content="02" />
                    <ComboBoxItem Content="03" />
                    <ComboBoxItem Content="04" />
                    <ComboBoxItem Content="05" />
                    <ComboBoxItem Content="06" />
                    <ComboBoxItem Content="07" />
                    <ComboBoxItem Content="08" />
                    <ComboBoxItem Content="09" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="13" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="17" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="19" />
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="21" />
                    <ComboBoxItem Content="22" />
                    <ComboBoxItem Content="23" />
                </ComboBox>
                <TextBlock Text=":" VerticalAlignment="Center" FontSize="16" Foreground="White"/>
                <ComboBox x:Name="MinuteComboBox"
                  Width="60"
                  Margin="10,0,0,0"
                  Background="#FF3C3C3C"
                  VerticalContentAlignment="Center">
                    <!-- Populate minutes 00 - 59 -->
                    <ComboBoxItem Content="00" />
                    <ComboBoxItem Content="01" />
                    <ComboBoxItem Content="02" />
                    <ComboBoxItem Content="03" />
                    <ComboBoxItem Content="04" />
                    <ComboBoxItem Content="05" />
                    <ComboBoxItem Content="06" />
                    <ComboBoxItem Content="07" />
                    <ComboBoxItem Content="08" />
                    <ComboBoxItem Content="09" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="11" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="13" />
                    <ComboBoxItem Content="14" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="17" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="19" />
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="21" />
                    <ComboBoxItem Content="22" />
                    <ComboBoxItem Content="23" />
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="25" />
                    <ComboBoxItem Content="26" />
                    <ComboBoxItem Content="27" />
                    <ComboBoxItem Content="28" />
                    <ComboBoxItem Content="29" />
                    <ComboBoxItem Content="30" />
                    <ComboBoxItem Content="31" />
                    <ComboBoxItem Content="32" />
                    <ComboBoxItem Content="33" />
                    <ComboBoxItem Content="34" />
                    <ComboBoxItem Content="35" />
                    <ComboBoxItem Content="36" />
                    <ComboBoxItem Content="37" />
                    <ComboBoxItem Content="38" />
                    <ComboBoxItem Content="39" />
                    <ComboBoxItem Content="40" />
                    <ComboBoxItem Content="41" />
                    <ComboBoxItem Content="42" />
                    <ComboBoxItem Content="43" />
                    <ComboBoxItem Content="44" />
                    <ComboBoxItem Content="45" />
                    <ComboBoxItem Content="46" />
                    <ComboBoxItem Content="47" />
                    <ComboBoxItem Content="48" />
                    <ComboBoxItem Content="49" />
                    <ComboBoxItem Content="50" />
                    <ComboBoxItem Content="51" />
                    <ComboBoxItem Content="52" />
                    <ComboBoxItem Content="53" />
                    <ComboBoxItem Content="54" />
                    <ComboBoxItem Content="55" />
                    <ComboBoxItem Content="56" />
                    <ComboBoxItem Content="57" />
                    <ComboBoxItem Content="58" />
                    <ComboBoxItem Content="59" />
                </ComboBox>
            </StackPanel>
        </StackPanel>


        <!--  Subject Input  -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,5"
                Text="Subject" />
            <TextBox
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Height="36"
                Margin="0,0,0,10"
                Padding="5"
                ToolTip="Enter the subject of the reminder"
                x:Name="SubjectTextBox" Background="#FF6B6B6B" />
        </StackPanel>

        <!--  Description Input  -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="0,0,0,5"
                Text="Description" />
            <TextBox
                AcceptsReturn="True"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Height="80"
                Margin="0,0,0,10"
                Padding="5"
                TextWrapping="Wrap"
                ToolTip="Enter a description for the reminder"
                x:Name="DescriptionTextBox" Background="#FF6B6B6B" />
        </StackPanel>

        <!--  Alarm Dropdown  -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#FFF7EFEF"
                Margin="0,0,0,5"
                Text="Alarm Sound" />
            <ComboBox
                Background="#FF3C3C3C"
                BorderBrush="#FF3C3C3C"
                BorderThickness="1"
                Height="35"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,10"
                Padding="5"
                ToolTip="Select an alarm sound"
                VerticalContentAlignment="Center"
                x:Name="AlarmComboBox">
                <ComboBoxItem Content="Default" Tag="{x:Null}" />
            </ComboBox>
        </StackPanel>


        <!--  Buttons  -->
        <StackPanel
            Grid.Row="6"
            HorizontalAlignment="Center"
            Margin="0,20,0,0"
            Orientation="Horizontal">

            <Button
    Background="#10B981"
    BorderBrush="#059669"
    BorderThickness="0"
    Click="SaveReminderButton_Click"
    Content="Save"
    Cursor="Hand"
    FontWeight="Bold"
    Foreground="White"
    Height="40"
    Width="120"
    Padding="1"
    Margin="0,0,10,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>


        </StackPanel>
        <ComboBox HorizontalAlignment="Left" Margin="688,32,0,0" Grid.Row="3" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>
